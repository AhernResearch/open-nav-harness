{
  "host": "127.0.0.1",
  "port": 8878,
  "max_workers": 2,
  "ssh_config": null,
  "import_roots": [],
  "service_templates": {
    "qwen27b": {
      "host": "a100",
      "working_directory": "/srv/nav-harness",
      "argv": [
        "/srv/venvs/vllm/bin/vllm",
        "serve",
        "/srv/models/Qwen3.6-27B",
        "--host",
        "127.0.0.1",
        "--port",
        "18101",
        "--served-model-name",
        "navh-qwen27b",
        "--max-model-len",
        "16384",
        "--max-num-seqs",
        "2",
        "--gpu-memory-utilization",
        "0.82",
        "--enable-auto-tool-choice",
        "--tool-call-parser",
        "qwen3_coder",
        "--reasoning-parser",
        "qwen3",
        "--limit-mm-per-prompt",
        "{\"image\":32}",
        "--mm-processor-cache-gb",
        "0",
        "--enforce-eager"
      ],
      "environment": {
        "HF_HUB_OFFLINE": "1"
      },
      "startup_timeout_s": 1200
    },
    "owned-lightnav": {
      "host": "a100",
      "working_directory": "/srv/nav-harness/releases/RELEASE",
      "argv": [
        "/srv/venvs/lightnav/bin/python",
        "-m",
        "navgpt.vla.worker",
        "--config",
        "/srv/nav-harness/deployment/actor-lightnav.json"
      ],
      "environment": {
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1"
      },
      "startup_timeout_s": 900
    },
    "owned-navgpt": {
      "host": "a100",
      "working_directory": "/srv/nav-harness/releases/RELEASE",
      "argv": [
        "/srv/venvs/navgpt/bin/python",
        "-m",
        "navgpt.vla.worker",
        "--config",
        "/srv/nav-harness/deployment/actor-navgpt.json"
      ],
      "environment": {
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1"
      },
      "startup_timeout_s": 900
    }
  }
}
