[Unit]
Description=Nav Harness control API
After=network-online.target

[Service]
WorkingDirectory=/srv/nav-harness
ExecStart=/srv/nav-harness/.venv/bin/nav-harness --state /srv/nav-harness/state --settings /srv/nav-harness/state/platform.json serve
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
