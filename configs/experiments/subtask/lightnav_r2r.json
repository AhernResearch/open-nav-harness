{
  "gpus": [
    3
  ],
  "dataset": {
    "name": "r2r",
    "split": "val_unseen",
    "episodes": "0-9"
  },
  "environment": {
    "url": "http://127.0.0.1:19350",
    "max_steps": 500,
    "forward_view_px": 512,
    "panorama_view_px": 400,
    "turn_angle_deg": 15,
    "step_size_m": 0.25,
    "allow_sliding": true
  },
  "vla": {
    "backend": "lightnav",
    "url": "http://127.0.0.1:18070",
    "policy_url": "ws://127.0.0.1:8050",
    "control_dt_s": 0.1,
    "max_linear_mps": 2.5,
    "max_angular_dps": 300.0
  },
  "harness": {
    "interface": "standard",
    "review_every": 0,
    "route_finding": true,
    "vla_steps_per_call": 200,
    "mode": "subtask",
    "subtask_max_distance_m": 3.0,
    "subtask_max_turn_deg": 180.0,
    "subtask_max_actions": 80
  },
  "output": {
    "dir": "outputs/subtask",
    "save_frames": true
  },
  "name": "lightnav_subtask_r2r",
  "planner": {
    "runtime": "codex",
    "model": "gpt-5.6-sol",
    "effort": "high",
    "max_turns": 100,
    "episode_timeout_s": 1200,
    "max_budget_usd": null
  }
}
