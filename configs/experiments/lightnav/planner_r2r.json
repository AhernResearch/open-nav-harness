{
  "gpus": [
    3
  ],
  "dataset": {
    "name": "r2r",
    "split": "val_unseen",
    "episodes": "0-2"
  },
  "environment": {
    "url": "http://127.0.0.1:19250",
    "max_steps": 500,
    "forward_view_px": 512,
    "panorama_view_px": 400,
    "turn_angle_deg": 15,
    "step_size_m": 0.25,
    "allow_sliding": true
  },
  "vla": {
    "backend": "lightnav",
    "url": "http://127.0.0.1:18050",
    "policy_url": "ws://127.0.0.1:8050",
    "control_dt_s": 0.1,
    "max_linear_mps": 2.5,
    "max_angular_dps": 300.0
  },
  "harness": {
    "interface": "standard",
    "review_every": 0,
    "route_finding": true,
    "vla_steps_per_call": 200
  },
  "output": {
    "dir": "outputs/lightnav",
    "save_frames": true
  },
  "name": "lightnav_planner_r2r",
  "planner": {
    "runtime": "codex",
    "model": "gpt-5.6-sol",
    "effort": "high",
    "max_turns": 100,
    "episode_timeout_s": 1200,
    "max_budget_usd": null,
    "tools": [
      "observe_forward",
      "observe_panorama",
      "observe_map",
      "navigate_by_instruction",
      "navigate_relative",
      "navigate_to_node",
      "annotate_node",
      "terminate_episode"
    ]
  }
}
